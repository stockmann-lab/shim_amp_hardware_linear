			)
			(justify right bottom)
		)
		(uuid "f05a37a5-ba00-4e66-9620-9890b0e0cdbc")
	)
	(text "17 mA max."
		(exclude_from_sim no)
		(at 218.44 210.82 0)
		(effects
			(font
