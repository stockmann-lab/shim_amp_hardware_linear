		(uuid "70f8cf7b-72c5-43cf-8269-98266c66b432")
	)
	(text_box "FPGA_Vin <= 17V, so max. dissipation in R78 is...\n17V / (3.3K + (16.7K per channel / 8 channels)) = 3.2 mA\n3.2 mA^2 * 3.3K = 33 mW"
		(exclude_from_sim no)
		(at 251.46 177.8 0)
		(size 62.23 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
