	(text_box "Forces all amplifiers into shutdown unless \"manual enable input\" sensor sees light"
		(exclude_from_sim no)
		(at 231.14 234.95 0)
		(size 22.86 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
